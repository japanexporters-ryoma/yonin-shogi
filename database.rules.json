{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[A-Z2-9]{6}$/)",
        "meta": {
          ".write": "!data.exists() && $room.matches(/^[A-Z2-9]{6}$/)",
          "startedAt": {
            ".write": "!data.exists()",
            ".validate": "newData.isNumber()"
          }
        },
        "seats": {
          "$seat": {
            ".write": "$seat.matches(/^s[0-3]$/) && root.child('rooms').child($room).child('meta').exists() && (!data.exists() || data.child('clientId').val() === newData.child('clientId').val())",
            ".validate": "newData.child('clientId').isString() && newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "actions": {
          "$action": {
            ".write": "!data.exists() && root.child('rooms').child($room).child('meta/startedAt').exists()",
            ".validate": "newData.hasChildren(['kind', 'by', 'at'])"
          }
        },
        "presence": {
          "$client": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          }
        }
      }
    }
  }
}
